# Use mosquitto when the simulator runs in Docker. Use localhost for a host run.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

SITE_ID=site-001
BATTERY_ID=BAT-001
SIMULATOR_SCENARIO=NORMAL
PUBLISH_INTERVAL_SECONDS=1

DASHBOARD_PORT=3000
OFFLINE_TIMEOUT_MS=15000

MPM_BASE_URL=http://host.docker.internal:8000
MPM_API_KEY=
MPM_INTERVAL_SECONDS=60
MPM_MAX_RETRIES=4

